# Elastic Cloud Serverless credentials
# Get these from your project dashboard at https://cloud.elastic.co
ELASTICSEARCH_URL=https://my-elasticsearch-project-xxxxx.es.us-east-1.aws.elastic.cloud
ELASTICSEARCH_API_KEY=your-api-key-here

# ── Sustainability model parameters (optional — research-backed defaults used if omitted) ──
# Sources: Patterson et al. (2021) arXiv:2104.10350 · IEA (2024) · Lannelongue et al. (2021)
#
# Grid carbon intensity in gCO₂eq/kWh  (IEA 2024 world avg = 386)
# Regional examples: US=386, EU=276, France=56, India=708, China=581
# GRID_CARBON_G_PER_KWH=386.0
#
# Energy per million LLM inference tokens on A100 GPU  (Patterson 2021)
# GPU_KWH_PER_MILLION_TOKENS=1.34
#
# Cooling + idle + networking overhead multiplier  (Lannelongue 2021)
# INFERENCE_OVERHEAD_FACTOR=1.2
#
# BPE tokenizer words-to-tokens ratio  (OpenAI tiktoken empirical avg)
# TOKENS_PER_WORD=1.3
#
# Uncertainty fraction for confidence interval bands  (±30%)
# UNCERTAINTY_FRACTION=0.30
